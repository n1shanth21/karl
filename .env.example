# Copy to .env and fill in. NEVER commit .env. NEVER paste values into chat.

# --- Photon / Spectrum (app.photon.codes -> your project -> Settings) ---
# Spectrum reads these automatically. Each person uses THEIR OWN project for local iMessage testing.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# terminal (default, no phone needed) | imessage | both
# Only ONE running process per Photon project, or every text gets answered twice.
MESSAGING_MODE=terminal

# --- Gemini (aistudio.google.com -> API keys). One shared key is fine. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-2

# --- Database ---
# memory = in-process fake DB (works with zero setup, data lost on restart)
# postgres = Tiger Data (needs DATABASE_URL)
DB_MODE=memory
DATABASE_URL=

# --- Server ---
PORT=3000
LOG_LEVEL=info
TZ=America/New_York
DASHBOARD_ORIGIN=http://localhost:3001
# Public base URL of this server (Railway URL in prod). Used to build listing photo links.
PUBLIC_BASE_URL=http://localhost:3000

# --- Agent identity ---
AGENT_NAME=Karl
AGENT_PHONE_DISPLAY=
