#!/bin/sh
# Blocks commits that touch files your branch doesn't own (see ownership.json).
BUN=$(command -v bun || echo "$HOME/.bun/bin/bun")
if [ ! -x "$BUN" ]; then echo "pre-commit: bun not found, skipping ownership check"; exit 0; fi
exec "$BUN" "$(git rev-parse --show-toplevel)/tools/guard.ts" precommit
